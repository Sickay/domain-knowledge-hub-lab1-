:TS_03 rdf:type :TemperatureSensor ; :hasId "TS-03" ; :hasTemp 45.0 ; :hasStatus "normal" .
:PS_03 rdf:type :PressureSensor ; :hasId "PS-03" ; :hasPressure 0.60 ; :hasStatus "normal" .
:VS_03 rdf:type :VibrationSensor ; :hasId "VS-03" ; :hasVibration 0.9 ; :hasStatus "normal" .

