@prefix : <http://example.org/industrial-automation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/industrial-automation> a owl:Ontology ;
    dcterms:title "Industrial Automation Ontology"@en ;
    dcterms:creator "Knowledge Engineer"@uk ;
    owl:versionInfo "1.0.0" .

# Диз'юнктності основних класів
[ a owl:AllDisjointClasses ;
  owl:members ( :IndustrialEquipment :SoftwareSystem :CommunicationNetwork :Sensor :SafetyInterlock )
] .

# Класи та ієрархія
:IndustrialEquipment a owl:Class .
:MachineTool a owl:Class ; rdfs:subClassOf :IndustrialEquipment .
:CNC16K20F3 a owl:Class ; rdfs:subClassOf :MachineTool .
:Spindle a owl:Class ; rdfs:subClassOf :IndustrialEquipment .
:SoftwareSystem a owl:Class .
:PLCController a owl:Class ; rdfs:subClassOf :SoftwareSystem .
:Sensor a owl:Class .
:TemperatureSensor a owl:Class ; rdfs:subClassOf :Sensor .
:SafetyInterlock a owl:Class .

# Кардинальні обмеження та аксіоми існування
:CNC16K20F3 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasPart ;
    owl:someValuesFrom :Spindle
] .

:CNC16K20F3 rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasAxisCount ;
    owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
    owl:onDataRange xsd:integer
] .

# Object Properties з характеристиками
:controls a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain :PLCController ;
    rdfs:range :IndustrialEquipment .

:monitors a owl:ObjectProperty ;
    rdfs:domain :SoftwareSystem ;
    rdfs:range :Sensor .

:monitoredBy a owl:ObjectProperty ;
    owl:inverseOf :monitors .

:hasPart a owl:ObjectProperty, owl:TransitiveProperty .

# Data Properties
:hasId a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:hasTemp a owl:DatatypeProperty ;
    rdfs:domain :IndustrialEquipment ;
    rdfs:range xsd:float .

:hasPressure a owl:DatatypeProperty ;
    rdfs:domain :IndustrialEquipment ;
    rdfs:range xsd:float .

:hasAxisCount a owl:DatatypeProperty ;
    rdfs:domain :MachineTool ;
    rdfs:range xsd:integer .

:hasStatus a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .
